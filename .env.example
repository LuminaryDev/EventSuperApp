# Copy to .env.local and fill in values (never commit .env.local).

# Public
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only — API pool (RLS). Per request that touches RLS-protected tables, use withSessionUser().
DATABASE_URL_WEB=postgresql://eventapp_web:YOUR_SECRET@localhost:5432/event_superapp

# Server-only — worker role (BYPASSRLS). Webhooks, jobs, bootstrap only.
DATABASE_URL_WORKER=postgresql://eventapp_worker:YOUR_SECRET@localhost:5432/event_superapp

# Long random secret for hashing ticket redemption codes (peppered SHA-256, etc.)
TICKET_REDEMPTION_PEPPER=
